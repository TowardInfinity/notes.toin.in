rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Single-user app: only the owner account may read/write any document.
    // NOTE: also disable new sign-ups in Firebase Console (Authentication -> Sign-up method),
    // so strangers cannot even create accounts against this project.
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.email == 'mobshshir@toin.in';
    }
  }
}
